{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch (komodo-qt)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/qt/komodo-qt",
            "args": ["-minrelaytxfee=0.000035", "-opretmintxfee=0.004","-debug=mempool","-listen=0","-server=1"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch (komodo-qt, PUNTEN)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/qt/komodo-qt",
            "args": ["-ac_name=PUNTEN", "-ac_reward=300000000", "-ac_nk=96,5", "-testnode=1", "-debug=chk"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Launch (komodo-test)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/komodo-test",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: try-fork-before-checkpoint.py",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/qa/checkpoints-tests/try-fork-before-checkpoint.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/qa/checkpoints-tests/venv/bin/python3",
            "cwd": "${workspaceFolder}/qa/checkpoints-tests",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/qa/checkpoints-tests"
            }
        }
    ]
}
